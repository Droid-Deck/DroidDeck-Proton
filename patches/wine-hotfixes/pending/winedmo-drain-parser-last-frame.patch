From d13a5b7310e2d556091641e8366c1665cc4aa84a Mon Sep 17 00:00:00 2001
From: maxjivi05 <maxjividen@gmail.com>
Date: Sat, 7 Nov 2026 01:59:21 -0500
Subject: [PATCH] winedmo: Send the parser's last frame to the decoder at end
 of stream.

The H.264, MPEG-1/2 and WMV parsers hold each access unit until the next one starts, so the last one is still in the parser when the stream ends. transform_drain sent the decoder its end-of-stream without it, and that frame was lost: a player that waits for every frame it fed, like Burnout Paradise Remastered's intro, never finished the video. Drain now takes the held access unit out of the parser and sends it first. If the decoder still has output waiting, the access unit is kept and sent once that output is read, instead of being dropped.
---
 dlls/winedmo/unix_transform.c | 53 +++++++++++++++++++++++++++++------
 1 file changed, 44 insertions(+), 9 deletions(-)

diff --git a/dlls/winedmo/unix_transform.c b/dlls/winedmo/unix_transform.c
index 03e51cc26c..35522e7a04 100644
--- a/dlls/winedmo/unix_transform.c
+++ b/dlls/winedmo/unix_transform.c
@@ -64,6 +64,7 @@ struct unix_transform
     bool is_raw_video;
     bool draining;       /* NULL packet sent — flushing decoder */
     bool frame_pending;  /* frame holds undispatched output */
+    bool drain_packet_pending;
 
     /* Audio output conversion */
     SwrContext         *swr;
@@ -1306,6 +1307,21 @@ NTSTATUS transform_push_input( void *arg )
     return STATUS_SUCCESS;
 }
 
+static void send_drain_packets( struct unix_transform *t, bool decoder_idle )
+{
+    int ret;
+
+    if (t->drain_packet_pending)
+    {
+        if ((ret = avcodec_send_packet( t->avctx, t->parsed_packet )) == AVERROR(EAGAIN) && !decoder_idle)
+            return;
+        if (ret < 0)
+            WARN( "avcodec_send_packet: %d, dropping %d bytes\n", ret, t->parsed_packet->size );
+        t->drain_packet_pending = false;
+    }
+    avcodec_send_packet( t->avctx, NULL );
+}
+
 NTSTATUS transform_get_output( void *arg )
 {
     struct transform_get_output_params *params = arg;
@@ -1398,6 +1414,11 @@ NTSTATUS transform_get_output( void *arg )
                 TRACE( "receive %s frame ret %d pkt_dts %"PRId64" pts %"PRId64" duration %"PRId64"\n",
                        avcodec_get_name( t->avctx->codec_id ), ret,
                        (INT64)t->frame->pkt_dts, (INT64)t->frame->pts, (INT64)t->frame->duration );
+            if (ret == AVERROR(EAGAIN) && t->drain_packet_pending)
+            {
+                send_drain_packets( t, true );
+                continue;
+            }
             if (ret == AVERROR(EAGAIN)) { params->size = 0; return STATUS_MORE_PROCESSING_REQUIRED; }
             if (ret == AVERROR_EOF)     { params->size = 0; return STATUS_END_OF_FILE; }
             if (ret < 0)
@@ -1662,7 +1683,8 @@ NTSTATUS transform_drain( void *arg )
 {
     const struct transform_drain_params *params = arg;
     struct unix_transform *t = (void *)(UINT_PTR)params->transform.handle;
-    int ret;
+    uint8_t *parsed_data = NULL;
+    int parsed_size = 0;
 
     TRACE( "transform %p\n", t );
 
@@ -1674,20 +1696,32 @@ NTSTATUS transform_drain( void *arg )
 
     if (!t->draining)
     {
-        if (t->mpeg_es_assemble && t->mpeg_es_size)
+        if (t->parser)
+        {
+            av_parser_parse2( t->parser, t->avctx, &parsed_data, &parsed_size, NULL, 0,
+                              AV_NOPTS_VALUE, AV_NOPTS_VALUE, AV_NOPTS_VALUE );
+            if (parsed_size)
+            {
+                av_packet_unref( t->parsed_packet );
+                if (av_new_packet( t->parsed_packet, parsed_size ) < 0)
+                    return STATUS_NO_MEMORY;
+                memcpy( t->parsed_packet->data, parsed_data, parsed_size );
+                t->parsed_packet->pts = t->parser->pts != AV_NOPTS_VALUE ? t->parser->pts : t->packet->pts;
+                t->parsed_packet->dts = t->parser->dts != AV_NOPTS_VALUE ? t->parser->dts : t->packet->dts;
+                t->parsed_packet->duration = t->packet->duration;
+                t->drain_packet_pending = true;
+            }
+        }
+        else if (t->mpeg_es_assemble && t->mpeg_es_size)
         {
             av_packet_unref( t->parsed_packet );
-            if ((ret = av_new_packet( t->parsed_packet, t->mpeg_es_size )) < 0)
+            if (av_new_packet( t->parsed_packet, t->mpeg_es_size ) < 0)
                 return STATUS_NO_MEMORY;
             memcpy( t->parsed_packet->data, t->mpeg_es_buf, t->mpeg_es_size );
-            if ((ret = avcodec_send_packet( t->avctx, t->parsed_packet )) < 0 && ret != AVERROR(EAGAIN))
-            {
-                WARN( "avcodec_send_packet: %d\n", ret );
-                return STATUS_UNSUCCESSFUL;
-            }
             t->mpeg_es_size = 0;
+            t->drain_packet_pending = true;
         }
-        avcodec_send_packet( t->avctx, NULL );
+        send_drain_packets( t, false );
         t->draining = true;
     }
     return STATUS_SUCCESS;
@@ -1711,6 +1745,7 @@ NTSTATUS transform_flush( void *arg )
     if (t->parsed_packet) av_packet_unref( t->parsed_packet );
     t->frame_pending      = false;
     t->draining           = false;
+    t->drain_packet_pending = false;
     t->audio_buf_filled   = 0;
     t->audio_buf_pos      = 0;
     t->video_buf_filled   = 0;
-- 
2.43.0

