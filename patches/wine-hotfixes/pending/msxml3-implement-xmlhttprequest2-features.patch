+/* Headers the HTTP stack computes from the request itself. Forwarding the caller's
+ * copy as well sends the header twice, which servers reject as a malformed request. */
+static BOOL is_restricted_request_header(const WCHAR *name)
+{
+    static const WCHAR *const restricted[] =
+    {
+        L"Content-Length", L"Host", L"Connection", L"Transfer-Encoding",
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(restricted); i++)
+        if (!wcsicmp(name, restricted[i])) return TRUE;
+    return FALSE;
+}
