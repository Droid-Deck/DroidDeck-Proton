+static DWORD WINAPI mta_context_callback_proc(void *arg)
+{
+    struct context_callback_params *cc = arg;
+    HRESULT init_hr = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+
+    if (FAILED(init_hr))
+    {
+        cc->hr = init_hr;
+        cc->executed = TRUE;
+        SetEvent(cc->done_event);
+        return 0;
+    }
+
+    cc->hr = cc->callback(cc->param);
+    cc->executed = TRUE;
+    CoUninitialize();
+    SetEvent(cc->done_event);
+    return 0;
+}
+
 static HRESULT WINAPI thread_context_callback_ContextCallback(IContextCallback *iface,
         PFNCONTEXTCALL callback, ComCallData *param, REFIID riid, int method, IUnknown *punk)
 {
-    FIXME("%p, %p, %p, %s, %d, %p\n", iface, callback, param, debugstr_guid(riid), method, punk);
+    struct thread_context *context = impl_from_IContextCallback(iface);
+    struct apartment *cur;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p, %p, %s, %d, %p (mt=%d tid=%#lx)\n", iface, callback, param,
+          debugstr_guid(riid), method, punk, context->multi_threaded, context->tid);
+
+    if (!callback)
+        return E_INVALIDARG;
+
+    if (context->multi_threaded)
+    {
+        cur = com_get_current_apt();
+        if (!cur || cur->multi_threaded)
+            return callback(param);
+
+        /* Cross-apartment STA -> MTA call: execute on an MTA worker thread while pumping STA. */
+        {
+            struct context_callback_params cc;
+            DWORD idx = 0;
+
+            memset(&cc, 0, sizeof(cc));
+            cc.callback = callback;
+            cc.param = param;
+            cc.hr = E_FAIL;
+            cc.done_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+            if (!cc.done_event)
+                return E_OUTOFMEMORY;
+            if (!QueueUserWorkItem(mta_context_callback_proc, &cc, WT_EXECUTEDEFAULT))
+            {
+                CloseHandle(cc.done_event);
+                return HRESULT_FROM_WIN32(GetLastError());
+            }
+            CoWaitForMultipleHandles(0, INFINITE, 1, &cc.done_event, &idx);
+            CloseHandle(cc.done_event);
+            return cc.executed ? cc.hr : E_FAIL;
+        }
+    }
+
+    if (context->tid == GetCurrentThreadId())
+        return callback(param);
+
+    {
+        struct apartment *target = apartment_findfromtid(context->tid);
+        struct context_callback_params cc;
+        HWND win;
+
+        if (!target || target->being_destroyed)
+        {
+            if (target) apartment_release(target);
+            return RPC_E_DISCONNECTED;
+        }
+        win = apartment_getwindow(target);
+        if (!win)
+        {
+            apartment_release(target);
+            return RPC_E_DISCONNECTED;
+        }
+        memset(&cc, 0, sizeof(cc));
+        cc.callback = callback;
+        cc.param = param;
+        cc.hr = RPC_E_DISCONNECTED;
+        cc.done_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+        if (!cc.done_event)
+        {
+            apartment_release(target);
+            return E_OUTOFMEMORY;
+        }
+        SendMessageW(win, DM_CONTEXTCALLBACK, 0, (LPARAM)&cc);
+        if (InterlockedCompareExchange(&cc.started, 0, 0) && !cc.executed)
+        {
+            DWORD idx = 0;
+            CoWaitForMultipleHandles(0, INFINITE, 1, &cc.done_event, &idx);
+        }
+        CloseHandle(cc.done_event);
+        apartment_release(target);
+        return cc.executed ? cc.hr : RPC_E_DISCONNECTED;
+    }
 }
 
