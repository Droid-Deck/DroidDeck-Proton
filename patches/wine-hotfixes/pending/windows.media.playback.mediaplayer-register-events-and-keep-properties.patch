+static HRESULT media_player_add_event( struct media_player *impl, enum media_player_event_kind kind,
+                                       IUnknown *handler, EventRegistrationToken *token )
+{
+    struct media_player_event_entry *entry;
+
+    if (!token) return E_POINTER;
+    token->value = 0;
+    if (!handler) return E_INVALIDARG;
+
+    if (!(entry = calloc( 1, sizeof( *entry ) ))) return E_OUTOFMEMORY;
+    entry->kind = kind;
+    entry->handler = handler;
+    IUnknown_AddRef( handler );
+
+    EnterCriticalSection( &impl->cs );
+    entry->token = ++impl->next_token;
+    list_add_tail( &impl->event_handlers, &entry->entry );
+    LeaveCriticalSection( &impl->cs );
+
+    token->value = entry->token;
+    return S_OK;
+}
+
+static HRESULT media_player_remove_event( struct media_player *impl, enum media_player_event_kind kind,
+                                          EventRegistrationToken token )
+{
+    struct media_player_event_entry *entry, *next;
+    IUnknown *to_release = NULL;
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &impl->event_handlers, struct media_player_event_entry, entry )
+    {
+        if (entry->kind == kind && entry->token == token.value)
+        {
+            list_remove( &entry->entry );
+            to_release = entry->handler;
+            free( entry );
+            break;
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+
+    if (to_release) IUnknown_Release( to_release );
+    return S_OK;
+}
+
+static IUnknown **media_player_snapshot_events( struct media_player *impl, enum media_player_event_kind kind,
+                                                size_t *out_count )
+{
+    struct media_player_event_entry *entry;
+    IUnknown **handlers = NULL;
+    size_t count = 0, i = 0;
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( entry, &impl->event_handlers, struct media_player_event_entry, entry )
+        if (entry->kind == kind) count++;
+
+    if (count && (handlers = malloc( count * sizeof( *handlers ) )))
+    {
+        LIST_FOR_EACH_ENTRY( entry, &impl->event_handlers, struct media_player_event_entry, entry )
+        {
+            if (entry->kind == kind)
+            {
+                IUnknown_AddRef( entry->handler );
+                handlers[i++] = entry->handler;
+            }
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+
+    *out_count = handlers ? i : 0;
+    return handlers;
+}
+
+static void media_player_notify_inspectable( struct media_player *impl, enum media_player_event_kind kind )
+{
+    size_t count = 0, i;
+    IUnknown **handlers = media_player_snapshot_events( impl, kind, &count );
+
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_MediaPlayer_IInspectable *cb = (ITypedEventHandler_MediaPlayer_IInspectable *)handlers[i];
+        ITypedEventHandler_MediaPlayer_IInspectable_Invoke( cb, &impl->IMediaPlayer_iface, NULL );
+        IUnknown_Release( handlers[i] );
+    }
+    free( handlers );
+}
+
+static void media_player_notify_rate_changed( struct media_player *impl, DOUBLE new_rate )
+{
+    size_t count = 0, i;
+    IUnknown **handlers = media_player_snapshot_events( impl, EVENT_RATE_CHANGED, &count );
+    struct media_player_rate_changed_args *args;
+
+    if (!count)
+    {
+        free( handlers );
+        return;
+    }
+
+    args = calloc( 1, sizeof( *args ) );
+    if (args)
+    {
+        args->IMediaPlayerRateChangedEventArgs_iface.lpVtbl = &rate_changed_args_vtbl;
+        args->ref = 1;
+        args->new_rate = new_rate;
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        if (args)
+        {
+            ITypedEventHandler_MediaPlayer_MediaPlayerRateChangedEventArgs *cb =
+                (ITypedEventHandler_MediaPlayer_MediaPlayerRateChangedEventArgs *)handlers[i];
+            ITypedEventHandler_MediaPlayer_MediaPlayerRateChangedEventArgs_Invoke(
+                cb, &impl->IMediaPlayer_iface, &args->IMediaPlayerRateChangedEventArgs_iface );
+        }
+        IUnknown_Release( handlers[i] );
+    }
+    if (args) IMediaPlayerRateChangedEventArgs_Release( &args->IMediaPlayerRateChangedEventArgs_iface );
+    free( handlers );
+}
