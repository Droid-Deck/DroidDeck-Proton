+static inline struct media_player_rate_changed_args *impl_from_IMediaPlayerRateChangedEventArgs(
+        IMediaPlayerRateChangedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct media_player_rate_changed_args, IMediaPlayerRateChangedEventArgs_iface );
+}
+
+static HRESULT WINAPI rate_changed_args_QueryInterface( IMediaPlayerRateChangedEventArgs *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IMediaPlayerRateChangedEventArgs ))
+    {
+        *out = iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI rate_changed_args_AddRef( IMediaPlayerRateChangedEventArgs *iface )
+{
+    struct media_player_rate_changed_args *impl = impl_from_IMediaPlayerRateChangedEventArgs( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI rate_changed_args_Release( IMediaPlayerRateChangedEventArgs *iface )
+{
+    struct media_player_rate_changed_args *impl = impl_from_IMediaPlayerRateChangedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI rate_changed_args_GetIids( IMediaPlayerRateChangedEventArgs *iface, ULONG *iid_count, IID **iids )
+{
+    *iid_count = 0;
+    *iids = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI rate_changed_args_GetRuntimeClassName( IMediaPlayerRateChangedEventArgs *iface, HSTRING *class_name )
+{
+    return WindowsCreateString( L"Windows.Media.Playback.MediaPlayerRateChangedEventArgs",
+                                wcslen( L"Windows.Media.Playback.MediaPlayerRateChangedEventArgs" ), class_name );
+}
+
+static HRESULT WINAPI rate_changed_args_GetTrustLevel( IMediaPlayerRateChangedEventArgs *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI rate_changed_args_get_NewRate( IMediaPlayerRateChangedEventArgs *iface, DOUBLE *value )
