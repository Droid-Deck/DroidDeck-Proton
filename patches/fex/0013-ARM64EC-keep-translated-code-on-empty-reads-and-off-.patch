@@ -1208,8 +1219,20 @@ void BTCpu64NotifyReadFile(HANDLE Handle, void* Address, SIZE_T Size, BOOL After
     return;
   }
 
+  // A read that wrote nothing - a zero-length, NULL-buffer poll of a pipe or socket - must not reach
+  // InvalidateAlignedInterval, where a NULL address means the whole process: games poll like that every frame. And a
+  // read into memory that cannot hold code has nothing to invalidate, so it need not stop every other thread for it.
   if (After && Status == STATUS_SUCCESS) {
+    if (!Address || !Size) {
+      FEXCore::Diag::Note(FEXCore::Diag::ReadNull);
+      return;
+    }
+    if (!InvalidationTracker->IntersectsExecutable(reinterpret_cast<uint64_t>(Address), static_cast<uint64_t>(Size))) {
+      FEXCore::Diag::Note(FEXCore::Diag::ReadData, Size);
+      return;
+    }
     std::scoped_lock Lock(ThreadCreationMutex);
+    FEXCore::Diag::Note(FEXCore::Diag::ReadFile, Size);
     InvalidationTracker->InvalidateAlignedInterval(reinterpret_cast<uint64_t>(Address), static_cast<uint64_t>(Size), false);
   }
 }
