+
+    if (!ppSwapChain || !pDesc || !pWindow || !pDevice)
+      return DXGI_ERROR_INVALID_CALL;
+
+    // Core windows only accept flip-model swap chains
+    if (pDesc->SwapEffect != DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL
