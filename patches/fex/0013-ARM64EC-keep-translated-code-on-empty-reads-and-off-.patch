 inline void VirtualDontNeed(void* Ptr, size_t Size, bool Recommit = true) {
-  // Zero the page-aligned region, preserving permissions.
-  MEMORY_BASIC_INFORMATION Info;
-  ::VirtualQuery(Ptr, &Info, sizeof(Info));
-  ::VirtualFree(Ptr, Size, MEM_DECOMMIT);
-  if (Recommit) {
-    ::VirtualAlloc(Ptr, Size, MEM_COMMIT, Info.Protect);
-  }
+  // Zero the page-aligned region, preserving permissions. Wine implements MEM_RESET as madvise(MADV_DONTNEED), so
+  // these private pages read back as zeros and their memory goes back to the system: what a decommit and recommit
+  // achieve, in one call instead of three that each take Wine's global virtual memory lock.
+  ::VirtualAlloc(Ptr, Size, MEM_RESET, PAGE_NOACCESS);
 }
 
 inline bool VirtualProtect(void* Ptr, size_t Size, ProtectOptions options) {
diff --git a/FEXCore/include/FEXCore/Utils/DiagCounters.h b/FEXCore/include/FEXCore/Utils/DiagCounters.h
new file mode 100644
index 000000000..2bba1783f
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/DiagCounters.h
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: MIT
+// DDO Mobile: opt-in counters of code invalidations by source, cache loads, compiles and full clears, logged every 5 s.
+// Off unless DDO_FEX_DIAG is set (with FEX_SILENTLOG=0 so the summaries reach the log); disabled, Note is one branch.
+#pragma once
+#include <FEXCore/Utils/LogManager.h>
+#include <FEXCore/fextl/fmt.h>
+#include <FEXCore/fextl/string.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+
+namespace FEXCore::Diag {
+enum Counter {
+  ReadFile,
+  ReadNull,
+  ReadData,
+  MemFree,
+  MemAlloc,
+  MemProtect,
+  Unmap,
+  FlushIC,
+  FlushICHeavy,
+  Dirty,
+  GuestRange,
+  ExecFault,
+  NonImageView,
+  RWXFault,
+  ExecFlags,
+  ErasedRanges,
+  LoadedBlocks,
+  CompiledBlocks,
+  ClearCodeCache,
+  Count
+};
+inline constexpr const char* Names[Count] = {"readfile",  "readnull",   "readdata",   "free",     "alloc",  "protect", "unmap",
+                                             "flushic",   "flushicheavy", "dirty",    "guestrange", "execfault", "nonimage", "rwxfault",
+                                             "execflags", "ERASED",     "LOADED",     "COMPILED", "CLEARALL"};
+inline const bool Enabled = [] {
+  const char* Value = getenv("DDO_FEX_DIAG");
+  return Value && Value[0] && Value[0] != '0';
+}();
+inline std::atomic<uint64_t> Calls[Count];
+inline std::atomic<uint64_t> Bytes[Count];
+inline std::atomic<int64_t> LastReport;
+
+inline void MaybeReport() {
+  const int64_t Now = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+  int64_t Last = LastReport.load(std::memory_order_relaxed);
+  if (Now - Last < 5000 || !LastReport.compare_exchange_strong(Last, Now)) {
+    return;
+  }
+  fextl::string Line = "[ddo-diag]";
+  for (int i = 0; i < Count; i++) {
+    const auto C = Calls[i].exchange(0, std::memory_order_relaxed);
+    const auto B = Bytes[i].exchange(0, std::memory_order_relaxed);
+    if (C) {
+      Line += fextl::fmt::format(" {}={}", Names[i], C);
+      if (B) {
+        Line += fextl::fmt::format("/{}KB", B >> 10);
+      }
+    }
+  }
+  LogMan::Msg::IFmt("{}", Line);
+}
+
+inline void Note(Counter C, uint64_t Size = 0) {
+  if (!Enabled) {
+    return;
+  }
+  Calls[C].fetch_add(1, std::memory_order_relaxed);
+  // Whole-process ranges would swamp the byte totals.
+  Bytes[C].fetch_add(Size < (uint64_t {1} << 48) ? Size : 0, std::memory_order_relaxed);
+  MaybeReport();
+}
+} // namespace FEXCore::Diag
