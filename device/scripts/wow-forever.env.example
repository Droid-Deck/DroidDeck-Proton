# Optional overrides for Launch-BattleNet.sh (Battle.net Steam shortcut).
# Copy to /usr/local/etc/wow-forever.env only if you need non-default paths.
#
# === Configure in DroidDeck / Steam ===
#   Target: Battle.net Launcher.exe
#   Compatibility: DroidDeck-Proton build with your WoW tier-8 test
#   Launch options: /usr/local/bin/Launch-BattleNet.sh %command%
#   Session: Linux Vulkan driver
#
# === Typical path overrides ===
# WOW_ROOT=/root/Storage/Game
# BNET_DIR=/root/Storage/Battle.net
# BNET_APPID=4153382437
#
# === Launch logging (per Play: /tmp/wow-launch-APPID/bnet-TIMESTAMP-pid/) ===
# WOW_LOGDIR=/tmp/wow-launch-4153382437
# Symlink: .../bnet-latest -> latest session
#
# BNET_PROTON_LOG=1          # default on; Proton logs under session dir
# BNET_WINEDEBUG=+err,+seh   # override Wine trace (avoid +file on long sessions)
# WOW_PROTON_LOG / WOW_WINEDEBUG — same if BNET_* unset
#
# === FEX ===
# FEX_APP_DATA_LOCATION=/run/droiddeck/fex-4153382437/
# FEX_BNET_FORCE_X86=1
# FEX_DYNAMICL1CACHE=0
#
# BNET_NO_STAMPER=1   # only for debugging; leave unset for DroidDeck picture/focus
