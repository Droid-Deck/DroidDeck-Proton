From e66bba67976ec1e91c50590f7ce2f5dffa419768 Mon Sep 17 00:00:00 2001
From: maxjivi05 <maxjividen@gmail.com>
Date: Thu, 12 Nov 2026 20:41:26 -0500
Subject: [PATCH] ntdll, server: Reuse closed private events without a server
 request.

An anonymous event that only its creating handle has ever referred to is
kept by the client when that handle is closed, and handed back by the
next matching NtCreateEvent. The server marks such an event in its shared
slot and withdraws the mark as soon as the handle is looked up, duplicated,
made inheritable or closed on the server side.
---
 dlls/ntdll/unix/esync.c        | 30 +++++++++++
 dlls/ntdll/unix/esync.h        |  2 +
 dlls/ntdll/unix/server.c       | 47 ++++++++--------
 dlls/ntdll/unix/sync.c         | 99 +++++++++++++++++++++++++++++++++-
 dlls/ntdll/unix/unix_private.h |  1 +
 server/esync.c                 | 23 ++++++++
 server/esync.h                 |  2 +
 server/event.c                 |  8 +++
 server/handle.c                |  4 ++
 server/object.c                |  1 +
 server/object.h                |  1 +
 11 files changed, 196 insertions(+), 22 deletions(-)

diff --git a/dlls/ntdll/unix/esync.c b/dlls/ntdll/unix/esync.c
index de02a56..62c3c0c 100644
--- a/dlls/ntdll/unix/esync.c
+++ b/dlls/ntdll/unix/esync.c
@@ -41,6 +41,8 @@ WINE_DEFAULT_DEBUG_CHANNEL(esync);
 #define ESYNC_PER_CHUNK  (ESYNC_CHUNK_SIZE / ESYNC_SLOT_SIZE)
 #define ESYNC_CHUNKS     8192
 #define ESYNC_MANUAL     1
+#define ESYNC_PRIVATE    2
+#define ESYNC_CLOSED     4
 #define ESYNC_WAITER     0x100
 #define ESYNC_RELEASING  1
 #define ESYNC_PULSE_NS   10000000
@@ -438,6 +440,24 @@ static LONG reset_manual( struct esync_slot *slot, int fd )
     return current;
 }
 
+BOOL esync_event_private( unsigned int shm_idx, BOOL *manual )
+{
+    struct esync_slot *slot = shm_idx ? get_slot( shm_idx ) : NULL;
+    int flags;
+
+    if (!slot) return FALSE;
+    flags = __atomic_load_n( &slot->flags, __ATOMIC_SEQ_CST );
+    *manual = !!(flags & ESYNC_MANUAL);
+    return (flags & (ESYNC_PRIVATE | ESYNC_CLOSED)) == ESYNC_PRIVATE;
+}
+
+BOOL esync_event_closed( unsigned int shm_idx )
+{
+    struct esync_slot *slot = shm_idx ? get_slot( shm_idx ) : NULL;
+
+    return slot && (__atomic_load_n( &slot->flags, __ATOMIC_SEQ_CST ) & ESYNC_CLOSED);
+}
+
 NTSTATUS esync_set_event( int fd, unsigned int shm_idx, LONG *prev )
 {
     struct esync_slot *slot = get_slot( shm_idx );
@@ -1101,6 +1121,16 @@ NTSTATUS esync_query_semaphore( int fd, unsigned int shm_idx, SEMAPHORE_BASIC_IN
     return STATUS_NOT_IMPLEMENTED;
 }
 
+BOOL esync_event_private( unsigned int shm_idx, BOOL *manual )
+{
+    return FALSE;
+}
+
+BOOL esync_event_closed( unsigned int shm_idx )
+{
+    return FALSE;
+}
+
 NTSTATUS esync_set_event( int fd, unsigned int shm_idx, LONG *prev )
 {
     return STATUS_NOT_IMPLEMENTED;
diff --git a/dlls/ntdll/unix/esync.h b/dlls/ntdll/unix/esync.h
index afa19fc..d2d5955 100644
--- a/dlls/ntdll/unix/esync.h
+++ b/dlls/ntdll/unix/esync.h
@@ -10,6 +10,8 @@ extern void esync_init( int shm_fd );
 extern void esync_release( unsigned int shm_idx );
 extern NTSTATUS esync_release_semaphore( int fd, unsigned int shm_idx, ULONG count, ULONG *prev );
 extern NTSTATUS esync_query_semaphore( int fd, unsigned int shm_idx, SEMAPHORE_BASIC_INFORMATION *info );
+extern BOOL esync_event_private( unsigned int shm_idx, BOOL *manual );
+extern BOOL esync_event_closed( unsigned int shm_idx );
 extern NTSTATUS esync_set_event( int fd, unsigned int shm_idx, LONG *prev );
 extern NTSTATUS esync_reset_event( int fd, unsigned int shm_idx, LONG *prev );
 extern NTSTATUS esync_pulse_event( int fd, unsigned int shm_idx, LONG *prev );
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index e596835..4db3448 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -2044,35 +2044,40 @@ NTSTATUS WINAPI NtClose( HANDLE handle )
     HANDLE port;
     unsigned int ret;
     void *sync;
-    int fd;
+    int fd, parked;
 
     if (HandleToLong( handle ) >= ~5 && HandleToLong( handle ) <= ~0)
         return STATUS_SUCCESS;
 
-    /* hold fd_cache_mutex to prevent the fd from being added again between the
-     * call to remove_fd_from_cache and close_handle */
-    server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
+    if ((parked = park_inproc_event( handle )) > 0) return STATUS_SUCCESS;
+    if (parked < 0) ret = STATUS_INVALID_HANDLE;
+    else
+    {
+        /* hold fd_cache_mutex to prevent the fd from being added again between the
+         * call to remove_fd_from_cache and close_handle */
+        server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
 
-    /* always remove the cached fd; if the server request fails we'll just
-     * retrieve it again */
-    fd = remove_fd_from_cache( handle );
-    if ((sync = begin_close_inproc_sync( handle ))) mutex_unlock( &fd_cache_mutex );
+        /* always remove the cached fd; if the server request fails we'll just
+         * retrieve it again */
+        fd = remove_fd_from_cache( handle );
+        if ((sync = begin_close_inproc_sync( handle ))) mutex_unlock( &fd_cache_mutex );
 
-    SERVER_START_REQ( close_handle )
-    {
-        req->handle = wine_server_obj_handle( handle );
-        ret = wine_server_call( req );
-    }
-    SERVER_END_REQ;
+        SERVER_START_REQ( close_handle )
+        {
+            req->handle = wine_server_obj_handle( handle );
+            ret = wine_server_call( req );
+        }
+        SERVER_END_REQ;
 
-    if (sync)
-    {
-        end_close_inproc_sync( sync );
-        pthread_sigmask( SIG_SETMASK, &sigset, NULL );
-    }
-    else server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+        if (sync)
+        {
+            end_close_inproc_sync( sync );
+            pthread_sigmask( SIG_SETMASK, &sigset, NULL );
+        }
+        else server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
 
-    if (fd != -1) close( fd );
+        if (fd != -1) close( fd );
+    }
 
     if (ret != STATUS_INVALID_HANDLE || !handle) return ret;
     if (!peb->BeingDebugged) return ret;
diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index 03ec551..3fd7cc9 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -678,7 +678,7 @@ static struct inproc_sync *get_cached_inproc_sync( HANDLE handle )
      * cache_inproc_sync()] */
     if (!interlocked_inc_if_nonzero( &cache->refcount )) return NULL;
 
-    if (cache->closed)
+    if (__atomic_load_n( &cache->closed, __ATOMIC_SEQ_CST ))
     {
         /* The object is still being used, but "handle" has been closed. The
          * handle value might have been reused for another object in the
@@ -740,6 +740,17 @@ static BOOL is_closing_inproc_sync( HANDLE handle )
     return InterlockedCompareExchange( &cache->refcount, 0, 0 ) && cache->closed == 2;
 }
 
+static BOOL is_parked_inproc_sync( HANDLE handle )
+{
+    unsigned int entry, idx = inproc_sync_handle_to_index( handle, &entry );
+    struct inproc_sync *cache;
+
+    if (entry >= INPROC_SYNC_CACHE_ENTRIES || !inproc_sync_cache[entry]) return FALSE;
+    cache = &inproc_sync_cache[entry][idx];
+    return InterlockedCompareExchange( &cache->refcount, 0, 0 ) &&
+           __atomic_load_n( &cache->closed, __ATOMIC_SEQ_CST ) == 3;
+}
+
 /* returns a pointer to a cache entry; if the object could not be cached,
  * returns "cache" instead, which should be allocated on stack */
 static NTSTATUS get_inproc_sync( HANDLE handle, enum inproc_sync_type desired_type, ACCESS_MASK desired_access,
@@ -766,6 +777,11 @@ static NTSTATUS get_inproc_sync( HANDLE handle, enum inproc_sync_type desired_ty
         server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
         if (!(sync = get_cached_inproc_sync( handle )))
         {
+            if (is_parked_inproc_sync( handle ))
+            {
+                server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+                return STATUS_INVALID_HANDLE;
+            }
             closing = is_closing_inproc_sync( handle );
             if ((ret = get_server_inproc_sync( handle, stack )))
             {
@@ -827,6 +843,81 @@ static NTSTATUS keep_inproc_sync( HANDLE handle, unsigned int serial )
     return ret;
 }
 
+#define PARKED_EVENTS 32
+
+static HANDLE parked_events[2][PARKED_EVENTS];
+
+int park_inproc_event( HANDLE handle )
+{
+    unsigned int entry, idx = inproc_sync_handle_to_index( handle, &entry ), i;
+    struct inproc_sync *cache;
+    unsigned short closed = 0;
+    BOOL manual;
+
+    if (do_fsync() || !do_esync() || inproc_device_fd < 0) return 0;
+    if (entry >= INPROC_SYNC_CACHE_ENTRIES || !inproc_sync_cache[entry]) return 0;
+    cache = &inproc_sync_cache[entry][idx];
+    if (!interlocked_inc_if_nonzero( &cache->refcount )) return 0;
+    if (__atomic_load_n( &cache->closed, __ATOMIC_SEQ_CST ) == 3)
+    {
+        release_inproc_sync( cache );
+        return -1;
+    }
+    if (cache->type != INPROC_SYNC_EVENT || cache->access != EVENT_ALL_ACCESS ||
+        !esync_event_private( cache->shm_idx, &manual ) ||
+        !__atomic_compare_exchange_n( &cache->closed, &closed, 3, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+    {
+        release_inproc_sync( cache );
+        return closed == 3 ? -1 : 0;
+    }
+    if (__atomic_load_n( &cache->refcount, __ATOMIC_SEQ_CST ) == 2)
+    {
+        for (i = 0; i < PARKED_EVENTS; i++)
+        {
+            if (InterlockedCompareExchangePointer( &parked_events[manual][i], handle, 0 )) continue;
+            release_inproc_sync( cache );
+            return 1;
+        }
+    }
+    __atomic_store_n( &cache->closed, 0, __ATOMIC_SEQ_CST );
+    release_inproc_sync( cache );
+    return 0;
+}
+
+static HANDLE take_parked_event( BOOL manual, BOOL state )
+{
+    unsigned int entry, idx, i;
+    struct inproc_sync *cache;
+    HANDLE handle;
+    BOOL type;
+
+    for (i = 0; i < PARKED_EVENTS; i++)
+    {
+        if (!__atomic_load_n( &parked_events[manual][i], __ATOMIC_RELAXED )) continue;
+        if (!(handle = InterlockedExchangePointer( &parked_events[manual][i], 0 ))) continue;
+        idx = inproc_sync_handle_to_index( handle, &entry );
+        cache = &inproc_sync_cache[entry][idx];
+        if (esync_event_closed( cache->shm_idx ))
+        {
+            cache->serial = 0;
+            __atomic_store_n( &cache->closed, 1, __ATOMIC_SEQ_CST );
+            release_inproc_sync( cache );
+            continue;
+        }
+        if (!esync_event_private( cache->shm_idx, &type ))
+        {
+            __atomic_store_n( &cache->closed, 0, __ATOMIC_SEQ_CST );
+            NtClose( handle );
+            continue;
+        }
+        if (state) esync_set_event( cache->fd, cache->shm_idx, NULL );
+        else esync_reset_event( cache->fd, cache->shm_idx, NULL );
+        __atomic_store_n( &cache->closed, 0, __ATOMIC_SEQ_CST );
+        return handle;
+    }
+    return 0;
+}
+
 void *begin_close_inproc_sync( HANDLE handle )
 {
     struct inproc_sync *cache;
@@ -1263,6 +1354,12 @@ NTSTATUS WINAPI NtCreateEvent( HANDLE *handle, ACCESS_MASK access, const OBJECT_
 
     *handle = 0;
     if (type != NotificationEvent && type != SynchronizationEvent) return STATUS_INVALID_PARAMETER;
+    if (inproc && do_esync() && access == EVENT_ALL_ACCESS &&
+        (!attr || (attr->Length == sizeof(*attr) && !attr->RootDirectory && !attr->ObjectName &&
+                   !(attr->Attributes & ~(OBJ_OPENIF | OBJ_CASE_INSENSITIVE)) &&
+                   !attr->SecurityDescriptor && !attr->SecurityQualityOfService)) &&
+        (*handle = take_parked_event( type == NotificationEvent, state )))
+        return STATUS_SUCCESS;
     if ((ret = alloc_object_attributes( attr, &objattr, &len ))) return ret;
 
     if (inproc) server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
index cc820b3..00bb3b2 100644
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -426,6 +426,7 @@ extern NTSTATUS wow64_wine_spawnvp( void *args );
 extern void dbg_init(void);
 
 extern void close_inproc_sync( HANDLE handle );
+extern int park_inproc_event( HANDLE handle );
 extern void *begin_close_inproc_sync( HANDLE handle );
 extern void end_close_inproc_sync( void *sync );
 
diff --git a/server/esync.c b/server/esync.c
index 508a189..9f139eb 100644
--- a/server/esync.c
+++ b/server/esync.c
@@ -33,6 +33,8 @@
 #define ESYNC_PER_CHUNK  (ESYNC_CHUNK_SIZE / ESYNC_SLOT_SIZE)
 #define ESYNC_CHUNKS     8192
 #define ESYNC_MANUAL     1
+#define ESYNC_PRIVATE    2
+#define ESYNC_CLOSED     4
 #define ESYNC_RELEASING  1
 
 struct esync_slot
@@ -411,6 +413,19 @@ void esync_cleanup_process( process_id_t pid )
     }
 }
 
+void esync_mark_private( unsigned int shm_idx )
+{
+    __atomic_or_fetch( &get_slot( shm_idx )->flags, ESYNC_PRIVATE, __ATOMIC_SEQ_CST );
+}
+
+void esync_mark_shared( unsigned int shm_idx, int closed )
+{
+    struct esync_slot *slot = get_slot( shm_idx );
+
+    if (closed) __atomic_or_fetch( &slot->flags, ESYNC_CLOSED, __ATOMIC_SEQ_CST );
+    __atomic_and_fetch( &slot->flags, ~ESYNC_PRIVATE, __ATOMIC_SEQ_CST );
+}
+
 void esync_set( int fd, unsigned int shm_idx, int locked )
 {
     struct esync_slot *slot = get_slot( shm_idx );
@@ -505,6 +520,14 @@ void esync_cleanup_process( process_id_t pid )
 {
 }
 
+void esync_mark_private( unsigned int shm_idx )
+{
+}
+
+void esync_mark_shared( unsigned int shm_idx, int closed )
+{
+}
+
 void esync_set( int fd, unsigned int shm_idx, int locked )
 {
 }
diff --git a/server/esync.h b/server/esync.h
index b94565c..06fe9a8 100644
--- a/server/esync.h
+++ b/server/esync.h
@@ -16,6 +16,8 @@ extern void esync_destroy( int fd, unsigned int shm_idx );
 extern unsigned int esync_grab( process_id_t pid, unsigned int shm_idx );
 extern void esync_client_release( process_id_t pid, unsigned int shm_idx );
 extern void esync_cleanup_process( process_id_t pid );
+extern void esync_mark_private( unsigned int shm_idx );
+extern void esync_mark_shared( unsigned int shm_idx, int closed );
 extern void esync_set( int fd, unsigned int shm_idx, int locked );
 extern void esync_reset( int fd, unsigned int shm_idx, int locked );
 extern void esync_abandon_mutex( int fd, unsigned int shm_idx, thread_id_t tid, int releasing );
diff --git a/server/event.c b/server/event.c
index e23aa65..467e4a5 100644
--- a/server/event.c
+++ b/server/event.c
@@ -35,6 +35,7 @@
 #include "thread.h"
 #include "request.h"
 #include "security.h"
+#include "esync.h"
 
 static const WCHAR event_name[] = {'E','v','e','n','t'};
 
@@ -395,7 +396,14 @@ DECL_HANDLER(create_event)
                                                           req->access, objattr->attributes );
         if (reply->handle && req->inproc_sync &&
             (reply->inproc_type = send_inproc_sync_fd( &event->obj, reply->handle, &reply->inproc_shm_idx )))
+        {
             reply->inproc_access = get_handle_access( current->process, reply->handle );
+            if (reply->inproc_shm_idx && !name.len && !root && !sd && !(objattr->attributes & OBJ_INHERIT))
+            {
+                event->obj.private_slot = reply->inproc_shm_idx;
+                esync_mark_private( reply->inproc_shm_idx );
+            }
+        }
         release_object( event );
     }
 
diff --git a/server/handle.c b/server/handle.c
index 3169c82..1393eb0 100644
--- a/server/handle.c
+++ b/server/handle.c
@@ -37,6 +37,7 @@
 #include "process.h"
 #include "thread.h"
 #include "security.h"
+#include "esync.h"
 #include "request.h"
 
 struct handle_entry
@@ -434,6 +435,7 @@ unsigned int close_handle( struct process *process, obj_handle_t handle )
     if (!(entry = get_handle( process, handle ))) return STATUS_INVALID_HANDLE;
     if (entry->access & RESERVED_CLOSE_PROTECT) return STATUS_HANDLE_NOT_CLOSABLE;
     obj = entry->ptr;
+    if (obj->private_slot) esync_mark_shared( obj->private_slot, 1 );
 
     /* the close_handle callback may terminate the process itself (e.g. the last
      * handle to a kill-on-close job containing it), which frees its handle table */
@@ -495,6 +497,7 @@ struct object *get_handle_obj( struct process *process, obj_handle_t handle,
             return NULL;
         }
         obj = entry->ptr;
+        if (obj->private_slot) esync_mark_shared( obj->private_slot, 0 );
         if (ops && (obj->ops != ops))
         {
             set_error( STATUS_OBJECT_TYPE_MISMATCH );  /* not the right type */
@@ -577,6 +580,7 @@ static int set_handle_flags( struct process *process, obj_handle_t handle,
         set_error( STATUS_INVALID_HANDLE );
         return -1;
     }
+    if (mask && entry->ptr->private_slot) esync_mark_shared( entry->ptr->private_slot, 0 );
     old_access = entry->access;
     mask  = (mask << RESERVED_SHIFT) & RESERVED_ALL;
     flags = (flags << RESERVED_SHIFT) & mask;
diff --git a/server/object.c b/server/object.c
index 103a208..a53d75b 100644
--- a/server/object.c
+++ b/server/object.c
@@ -308,6 +308,7 @@ void *alloc_object( const struct object_ops *ops )
         obj->refcount     = 1;
         obj->handle_count = 0;
         obj->is_permanent = 0;
+        obj->private_slot = 0;
         obj->ops          = ops;
         obj->name         = NULL;
         obj->sd           = NULL;
diff --git a/server/object.h b/server/object.h
index 833049c..54b12e6 100644
--- a/server/object.h
+++ b/server/object.h
@@ -120,6 +120,7 @@ struct object
     struct object_name       *name;
     struct security_descriptor *sd;
